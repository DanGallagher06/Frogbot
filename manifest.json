{
  "manifest_version": 3,
  "name": "Frogbot",
  "version": "0.2.0",
  "description": "A little frog that hops down finance articles and highlights the numbers that matter.",
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Frogbot",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  }
}
